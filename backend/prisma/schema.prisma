// Sprint 0.1 scaffold — data model only, NO business logic is implemented here.
// Overriding rules: docs/12_QUY_TAC_CHOT_CUNG.md (locked rules win over docs 00-11).
// In particular:
//  - SKU (ProductVariant) is the ONLY selling / inventory unit, never the parent Product.
//  - Every inventory change must go through an InventoryTransaction (service in a later sprint).
//  - paid_total / debt_total are DERIVED from active Payments (service in a later sprint),
//    never hand-edited. The stored fields on Order are snapshots to be recomputed, not inputs.
//  - A Customer has UNLIMITED phone numbers via CustomerPhone (no 2-phone limit),
//    exactly one primary phone, duplicate checking across ALL phones (later sprint).
//  - No hard delete of data that has transactions; prefer status / deletedAt.

generator client {
  provider = "prisma-client-js"
  // Docker image is node:20-bookworm-slim (Debian 12, OpenSSL 3). The slim
  // image has no `openssl` binary, so Prisma's engine detection fails and
  // defaults to the openssl-1.1.x engine, whose libssl.so.1.1 does NOT exist
  // on bookworm — migrate/seed then fail with "cannot open shared object
  // file: libssl.so.1.1". Pin the Debian OpenSSL 3 engine explicitly.
  // "native" keeps local npm dev (Windows/macOS/Linux) working as well.
  // NOTE: Prisma schema comments use //, never #. A # line inside a
  // generator block fails validation with P1012.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (basic MVP level) ----------

enum UserStatus {
  active
  inactive
  locked
}

enum CustomerStatus {
  active
  inactive
}

enum CustomerPhoneStatus {
  active
  inactive
}

enum ProductStatus {
  active
  inactive
}

enum ProductVariantStatus {
  active
  inactive
}

enum OrderStatus {
  // Sprint Đơn hàng — MVP đơn giản, chỉ 4 trạng thái (quyết định của chủ
  // dự án 2026-10-29). packing/shipping/returned KHÔNG được dùng ở MVP:
  // trả hàng được theo dõi bằng OrderItem.returnedQuantity và cờ
  // Order.fullyReturned, trạng thái đơn giữ nguyên.
  draft
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum PaymentRecordStatus {
  active
  cancelled
}

enum InventoryTransactionType {
  initial
  import
  export
  adjustment_increase
  adjustment_decrease
  set
  order_confirmed
  order_cancelled
  return
  // Sprint NCC-2 — purchase-order stock movements (mirror of the order
  // types, stock direction reversed: receipt ADDS stock).
  purchase_received
  purchase_cancelled
  purchase_return
}

enum PurchaseOrderStatus {
  draft
  confirmed
  completed
  cancelled
}

enum ReminderStatus {
  pending
  completed
  cancelled
}

// ---------- Auth / users ----------

model Role {
  id           String   @id @default(cuid())
  // Stable machine code used in seed data and permission checks:
  // admin, manager, sales, warehouse, accountant (docs 08, 5 default roles).
  code         String   @unique
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  users       User[]
  permissions RolePermission[]
}

// Permission codes are defined by the system (see src/lib/permissions.ts),
// never created freely from the UI in MVP (docs 08 §19.3).
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
  userOverrides UserPermissionOverride[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// Per-user permission overrides (Admin page: role + per-user customization).
// Effective permissions = role permissions + allow overrides - deny
// overrides (deny wins; a code can never be both allow and deny for one
// user — enforced by @@unique([userId, permissionId]) plus API checks).
// The override references Permission by id, mirroring RolePermission, so
// only real system codes can be stored. Overrides live in their own table
// and are NEVER touched by the role seed (seedRoles only upserts
// Role/Permission/RolePermission), so re-seeding keeps them intact.
model UserPermissionOverride {
  id           String @id @default(cuid())
  userId       String
  permissionId String
  // "allow": always granted even if the role lacks it.
  // "deny": always revoked even if the role grants it.
  effect       String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation("OverrideTarget", fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])
  createdBy User       @relation("OverrideGranter", fields: [createdById], references: [id])

  @@unique([userId, permissionId])
  @@index([userId])
}

model User {
  id           String     @id @default(cuid())
  // Login name (primary login identifier in Sprint Auth). Unique, required.
  username     String     @unique
  email        String     @unique
  phone        String?
  passwordHash String
  fullName     String
  status       UserStatus @default(active)
  roleId       String
  // Per-user OTP override (Sprint Auth, admin-controlled):
  // true  = always require email OTP, false = never require OTP,
  // null  = follow the system otp_mode setting.
  requireOtp   Boolean?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  role Role @relation(fields: [roleId], references: [id])

  auditLogs             AuditLog[]             @relation("AuditActor")
  createdOrders         Order[]                @relation("OrderCreator")
  createdPurchaseOrders PurchaseOrder[]        @relation("PurchaseOrderCreator")
  createdCustomers      Customer[]             @relation("CustomerCreator")
  createdSuppliers      Supplier[]             @relation("SupplierCreator")
  assignedCustomers     Customer[]             @relation("CustomerAssignee")
  createdPayments       Payment[]              @relation("PaymentCreator")
  cancelledPayments     Payment[]              @relation("PaymentCanceller")
  createdSupplierPayments   SupplierPayment[]  @relation("SupplierPaymentCreator")
  cancelledSupplierPayments SupplierPayment[]  @relation("SupplierPaymentCanceller")
  inventoryTransactions InventoryTransaction[] @relation("InventoryCreator")
  customerActivities    CustomerActivity[]     @relation("ActivityCreator")
  reminders             Reminder[]             @relation("ReminderCreator")
  assignedReminders     Reminder[]             @relation("ReminderAssignee")
  completedReminders    Reminder[]             @relation("ReminderCompleter")
  otpChallenges         OtpChallenge[]
  updatedSettings       SystemSetting[]        @relation("SettingUpdater")
  permissionOverrides   UserPermissionOverride[] @relation("OverrideTarget")
  grantedOverrides      UserPermissionOverride[] @relation("OverrideGranter")
}

// One row per login OTP challenge. The 6-digit code itself is NEVER stored
// in plain text — only its bcrypt hash. A challenge is single-use, expires
// after 5 minutes, and is locked after 5 wrong attempts.
model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  channel    String    @default("email")
  expiresAt  DateTime
  attempts   Int       @default(0)
  maxAttempts Int      @default(5)
  lastSentAt DateTime  @default(now())
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// System settings (key/value). Only the keys the code knows about are
// accepted by the admin API in MVP; otp_mode is the first one:
// 'off' (default) | 'email'. 'phone' is NOT a running mode in this sprint
// (no SMS provider yet) and must be rejected by the API.
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id])
}

// ---------- Customers ----------

model Customer {
  id          String         @id @default(cuid())
  fullName    String
  gender      String?
  dateOfBirth DateTime?
  address     String?
  email       String?
  note        String?
  source      String?
  status      CustomerStatus @default(active)
  // Data scope (Sprint Customer): who created the customer and who is
  // assigned to care for them. Users with only customer.view_own see
  // customers they created or are assigned to; customer.view_all sees all.
  // There is no team entity in MVP, so a "team" scope cannot be enforced
  // yet — see DEVELOPMENT_PLAN.md.
  createdById String?
  assignedToId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  createdBy  User? @relation("CustomerCreator", fields: [createdById], references: [id])
  assignedTo User? @relation("CustomerAssignee", fields: [assignedToId], references: [id])

  phones     CustomerPhone[]
  children   CustomerChild[]
  tagLinks   CustomerTagAssignment[]
  activities CustomerActivity[]
  reminders  Reminder[]
  orders     Order[]
  payments   Payment[]
}

model CustomerPhone {
  id              String              @id @default(cuid())
  customerId      String
  phone           String
  phoneNormalized String
  // Exactly one primary phone per customer (enforced by service in Customer sprint,
  // not by a DB partial unique index, to keep the scaffold portable).
  isPrimary       Boolean             @default(false)
  label           String?
  status          CustomerPhoneStatus @default(active)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  // Blocks a duplicate phone inside the same customer. The GLOBAL duplicate
  // check (against every phone of every other customer) is a service rule
  // in the Customer sprint, because it must ignore inactive phones and
  // report which existing customer already owns the number.
  @@unique([customerId, phoneNormalized])
  @@index([phoneNormalized])
}

model CustomerTag {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customerLinks CustomerTagAssignment[]
}

model CustomerTagAssignment {
  id         String   @id @default(cuid())
  customerId String
  tagId      String
  createdAt  DateTime @default(now())

  customer Customer    @relation(fields: [customerId], references: [id])
  tag      CustomerTag @relation(fields: [tagId], references: [id])

  @@unique([customerId, tagId])
}

model CustomerChild {
  id          String   @id @default(cuid())
  customerId  String
  fullName    String
  dateOfBirth DateTime?
  gender      String?
  note        String?
  // Display order inside the customer's children list (docs 11: sort_order).
  // Age is NEVER stored: it is computed from dateOfBirth on read.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
}

model CustomerActivity {
  id          String   @id @default(cuid())
  customerId  String
  type        String
  title       String
  content     String?
  // Sprint Chăm sóc: ngày thực hiện (mặc định hôm tạo) và kết quả
  // (docs 06 §5.3). Activities are immutable — no update/delete route.
  performedAt DateTime @default(now())
  result      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation("ActivityCreator", fields: [createdById], references: [id])
}

model Reminder {
  id             String         @id @default(cuid())
  // Sprint Chăm sóc: customer is optional (a general reminder may have
  // no customer). orderId/type are optional links (docs 06 §6.2).
  customerId     String?
  orderId        String?
  type           String?
  title          String
  description    String?
  dueAt          DateTime
  status         ReminderStatus @default(pending)
  assignedToId   String?
  completedAt    DateTime?
  completedById  String?
  completionNote String?
  cancelReason   String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  customer    Customer? @relation(fields: [customerId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id])
  createdBy   User?     @relation("ReminderCreator", fields: [createdById], references: [id])
  assignedTo  User?     @relation("ReminderAssignee", fields: [assignedToId], references: [id])
  completedBy User?     @relation("ReminderCompleter", fields: [completedById], references: [id])
}

// ---------- Suppliers (Sprint NCC-1: directory only) ----------
// NCC-2 will add PurchaseOrder / PurchaseOrderItem / SupplierPayment
// here. A supplier with purchase orders must never be hard-deleted —
// the hard-delete route must gain that guard in NCC-2 (see
// backend/src/routes/suppliers.ts).

enum SupplierStatus {
  active
  inactive
}

enum SupplierPhoneStatus {
  active
  inactive
}

model Supplier {
  id        String         @id @default(cuid())
  name      String
  // Tax code: optional, but unique when provided (design 13 §7.4).
  // Empty input is stored as null so the unique index never blocks
  // two suppliers that both have no tax code.
  taxCode   String?        @unique
  email     String?
  address   String?
  note      String?
  status    SupplierStatus @default(active)
  // Data scope mirrors customers: supplier.view_all sees all,
  // supplier.view_own sees only suppliers this user created.
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User?          @relation("SupplierCreator", fields: [createdById], references: [id])
  phones    SupplierPhone[]
  purchaseOrders PurchaseOrder[]
}

model SupplierPhone {
  id              String              @id @default(cuid())
  supplierId      String
  phone           String
  phoneNormalized String
  // Exactly one primary phone per supplier (enforced by service in
  // Sprint NCC-1, not by a DB partial unique index, to keep the
  // scaffold portable) — same rule as CustomerPhone.
  isPrimary       Boolean             @default(false)
  label           String?
  status          SupplierPhoneStatus @default(active)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  // Blocks a duplicate phone inside the same supplier. The GLOBAL
  // duplicate check (against every phone of every OTHER supplier) is
  // a service rule in Sprint NCC-1, because it must ignore inactive
  // phones and report which existing supplier already owns the number.
  // Phones are deliberately NOT checked against customer phones: one
  // number may belong to both a customer and a supplier (design 13 §7.3).
  @@unique([supplierId, phoneNormalized])
  @@index([phoneNormalized])
}

// ---------- Products / SKU ----------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  categoryId  String?
  status      ProductStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
}

model ProductVariant {
  id           String                @id @default(cuid())
  productId    String
  // Unique across the whole system; stored trimmed + upper-cased by the
  // service in the Product sprint. Never auto-change a user-entered SKU.
  sku          String                @unique
  variantName  String
  attributes   Json?
  // Exactly ONE default variant per product, and only for a product with
  // no attribute variants (Sprint Product/SKU). Enforced by the service:
  // at most one isDefault=true per product, and a simple product must
  // have exactly one. The DB has no partial unique index for this, to
  // keep the scaffold portable across providers.
  isDefault    Boolean               @default(false)
  sellingPrice Decimal               @db.Decimal(19, 2)
  importPrice  Decimal?              @db.Decimal(19, 2)
  barcode      String?               @unique
  status       ProductVariantStatus  @default(active)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  product               Product                @relation(fields: [productId], references: [id])
  inventoryItem         InventoryItem?
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  images                ProductImage[]
}

// Ảnh sản phẩm: ảnh chung của sản phẩm (variantId null — gallery, ảnh đầu
// tiên theo sortOrder là ảnh chính) hoặc thumbnail riêng của một SKU
// (variantId có giá trị — mỗi SKU tối đa 1 ảnh riêng, service xóa ảnh cũ
// khi đặt thumbnail mới). Người tạo ảnh đã có trong audit log nên bảng
// này không giữ createdById. Ảnh không phải dữ liệu giao dịch nên xóa
// ảnh là xóa thật cả dòng lẫn file, không qua soft-delete.
// File vật lý nằm trong thư mục uploads của backend, tên file sinh bằng
// uuid (không dùng tên gốc) để không lộ đường dẫn và tránh traversal.
model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  variantId    String?
  fileName     String
  originalName String?
  mimeType     String
  size         Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

// ---------- Inventory ----------

model InventoryItem {
  id        String   @id @default(cuid())
  // One current-stock row per SKU. Single-warehouse MVP: warehouseCode is
  // a label only ("MAIN"); multi-warehouse is explicitly OUT of MVP scope.
  variantId     String @unique
  warehouseCode String @default("MAIN")
  quantity      Int    @default(0)
  // Sprint Đơn hàng — số lượng đang bị đơn nháp GIỮ (reserved), chưa
  // trừ khỏi quantity vật lý. Tồn khả dụng = quantity - reservedQuantity.
  // Chỉ các hàm đặt giữ/giải phóng trong src/lib/orders.ts được sửa
  // trường này; quantity vật lý vẫn chỉ đổi qua inventory service.
  reservedQuantity Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  productVariantId String
  transactionType InventoryTransactionType
  quantityBefore  Int
  quantityChanged Int
  quantityAfter   Int
  reason          String
  referenceType   String?
  referenceId     String?
  createdById     String?
  // Immutable history: no updatedAt / deletedAt. Never edit in place.
  createdAt       DateTime                 @default(now())

  variant   ProductVariant @relation(fields: [productVariantId], references: [id])
  createdBy User?          @relation("InventoryCreator", fields: [createdById], references: [id])
}

// ---------- Orders / payments ----------

model Order {
  id                 String        @id @default(cuid())
  orderCode          String        @unique
  customerId         String
  status             OrderStatus   @default(draft)
  paymentStatus      PaymentStatus @default(unpaid)
  subtotal           Decimal       @db.Decimal(19, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(19, 2)
  shippingFee        Decimal       @default(0) @db.Decimal(19, 2)
  grandTotal         Decimal       @db.Decimal(19, 2)
  // Derived snapshots, recomputed by the Payment service after every
  // payment change. NEVER accept these values from the frontend as input.
  paidTotal          Decimal       @default(0) @db.Decimal(19, 2)
  debtTotal          Decimal       @default(0) @db.Decimal(19, 2)
  // Inventory flags (locked rules 2.3): prevent double deduct / restore.
  inventoryDeducted  Boolean       @default(false)
  inventoryDeductedAt DateTime?
  inventoryRestored  Boolean       @default(false)
  inventoryRestoredAt DateTime?
  // Sprint Đơn hàng — true khi mọi dòng đã trả hết (trả hàng một phần
  // hoặc toàn phần). Trạng thái đơn GIỮ NGUYÊN khi trả hết, vì MVP chỉ
  // có 4 trạng thái và không có trạng thái "returned".
  fullyReturned      Boolean       @default(false)
  // Phạm vi dữ liệu (Sprint Đơn hàng, giống Sprint Customer): user chỉ
  // có order.view_own chỉ thấy đơn do mình tạo.
  createdById        String?
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  customer Customer    @relation(fields: [customerId], references: [id])
  createdBy User?      @relation("OrderCreator", fields: [createdById], references: [id])
  items    OrderItem[]
  payments Payment[]
  reminders Reminder[]
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  // Selling unit is ALWAYS a variant/SKU, never the parent product.
  productVariantId     String
  // Snapshots at sale time: later product/SKU renames must not change old orders.
  skuSnapshot          String
  productNameSnapshot  String
  variantNameSnapshot  String
  unitPrice            Decimal  @db.Decimal(19, 2)
  discountAmount       Decimal  @default(0) @db.Decimal(19, 2)
  quantity             Int
  // Sprint Đơn hàng — số lượng đã trả của dòng này (trả hàng một phần).
  // Số lượng còn trả được = quantity - returnedQuantity.
  returnedQuantity     Int      @default(0)
  lineTotal            Decimal  @db.Decimal(19, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])
}

// ---------- Purchase orders (Sprint NCC-2) ----------

model PurchaseOrder {
  id        String              @id @default(cuid())
  code      String              @unique
  supplierId String
  status    PurchaseOrderStatus @default(draft)
  // Money is integer VND (đồng nguyên) in this module, unlike the
  // Decimal(19,2) sales orders. paidTotal/debtTotal are DERIVED and
  // recomputed server-side on every change; the frontend must never
  // send them as input. NCC-2 has no payments yet, so paidTotal stays
  // 0 and debtTotal = grandTotal; Sprint NCC-3 recomputes them from
  // active supplier payments. paymentStatus is a plain string (not an
  // enum) so NCC-3 can reuse the unpaid/partial/paid vocabulary
  // without a second enum migration.
  grandTotal    Int    @default(0)
  paidTotal     Int    @default(0)
  debtTotal     Int    @default(0)
  paymentStatus String @default("unpaid")
  // Receipt flags (locked rules 2.3, mirrored from sales orders):
  // receive exactly once, restore exactly once.
  received   Boolean   @default(false)
  receivedAt DateTime?
  restored   Boolean   @default(false)
  restoredAt DateTime?
  // True when every line is fully returned. Status does NOT change on
  // full return (MVP has only the 4 statuses, no "returned" status).
  fullyReturned Boolean @default(false)
  // Data scope mirrors orders: purchase.view_own sees only POs the
  // user created.
  createdById String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  payments  SupplierPayment[]
}

model PurchaseOrderItem {
  id            String @id @default(cuid())
  purchaseOrderId String
  // Receiving unit is ALWAYS a variant/SKU, never the parent product.
  variantId String
  // Snapshots at receipt time: later product/SKU renames must not
  // change old purchase orders.
  skuSnapshot         String
  productNameSnapshot String
  variantNameSnapshot String
  quantity            Int
  // Unit purchase cost, snapshot in integer VND. Receiving NEVER
  // rewrites the variant's current importPrice (design 13 §7.2).
  unitCost         Int
  // Sprint NCC-2 — quantity already returned to the supplier.
  // Returnable quantity = quantity - returnedQuantity.
  returnedQuantity Int      @default(0)
  lineTotal        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

// ---------- Supplier payments (Sprint NCC-3) ----------
// Mirrors the Payment model field-for-field (same names where they
// apply), except the money model is integer VND like the rest of the
// purchase module (no Decimal, no enum): amount is Int, status is a
// plain string ("active" / "cancelled"). The supplier is reached
// through the purchase order, so there is no supplierId column here.
// Cancelling never hard-deletes: status becomes "cancelled" with a
// mandatory reason, cancelledById and cancelledAt. There is NO
// hard-delete route for supplier payments, ever.
model SupplierPayment {
  id              String    @id @default(cuid())
  purchaseOrderId String
  amount          Int
  paymentMethod   String
  note            String?
  status          String    @default("active")
  cancelledReason String?
  cancelledById   String?
  cancelledAt     DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User?         @relation("SupplierPaymentCreator", fields: [createdById], references: [id])
  cancelledBy   User?         @relation("SupplierPaymentCanceller", fields: [cancelledById], references: [id])
}

model Payment {
  id            String              @id @default(cuid())
  orderId       String
  customerId    String
  amount        Decimal             @db.Decimal(19, 2)
  paymentMethod String
  paidAt        DateTime            @default(now())
  note          String?
  status        PaymentRecordStatus @default(active)
  cancelReason  String?
  cancelledById String?
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  order       Order     @relation(fields: [orderId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])
  createdBy   User?     @relation("PaymentCreator", fields: [createdById], references: [id])
  cancelledBy User?     @relation("PaymentCanceller", fields: [cancelledById], references: [id])
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  // Immutable history: no updatedAt / deletedAt.
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])
}
