# Copy to .env for local development. NEVER commit a real .env with secrets.
# Example only — no real credentials here.
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_ban_hang?schema=public"
# REQUIRED. The backend refuses to start without it. Generate a long random
# value, e.g. with: openssl rand -hex 32. Never use a default in production.
JWT_SECRET=change-me-to-a-long-random-value-in-local-env-only
JWT_EXPIRES_IN=8h
# SMTP for email OTP. Optional while otp_mode=off (the default).
# When otp_mode=email, SMTP must be configured or OTP_DEV_LOG=true (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Dev only: when true, OTP codes are printed to backend logs instead of
# emailed. NEVER enable OTP_DEV_LOG in production.
OTP_DEV_LOG=false
# First admin account (npm run seed:admin). All three are required, the
# password must be at least 8 characters, and no admin is created if one
# already exists. These values are never written into code.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
