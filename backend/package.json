{
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1"
  },
  "description": "CRM_Ban_Hang backend scaffold (Sprint 0.1) — Express + TypeScript + Prisma",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "prisma": "^5.17.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "name": "crm-ban-hang-backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "seed": "ts-node --transpile-only src/seed.ts",
    "seed:admin": "ts-node --transpile-only src/seedAdmin.ts",
    "start": "node dist/index.js"
  },
  "version": "0.1.0"
}
