# Copy to .env next to docker-compose.yml. NEVER commit a real .env.
# Used only by Docker Compose; npm dev reads backend/.env instead
# (same variable names, see backend/.env.example).
POSTGRES_PASSWORD=postgres
# REQUIRED. Generate a long random value, e.g. with: openssl rand -hex 32
# Do NOT use the example below in production.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=8h
# SMTP for email OTP (optional while otp_mode=off). Leave empty if unused.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Dev only: when true, OTP codes are printed to backend logs instead of
# emailed. NEVER enable in production.
OTP_DEV_LOG=false
# First admin account for `docker compose exec backend npm run seed:admin`.
# All three are required, password must be at least 8 characters.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
